<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:background="?attr/recyclerViewBackgroundColor"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_select_tag_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tagSearchBarBackgroundColor">

        <SearchView
            android:id="@+id/dialog_select_tag_searchview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:iconifiedByDefault="false"
            android:imeOptions="flagNoExtractUi"
            android:maxWidth="260dp"
            android:outlineProvider="background"
            android:paddingBottom="4dp"
            android:queryHint="Enter tag name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </SearchView>

        <Button
            android:id="@+id/dialog_select_tag_add_new_button"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="?attr/tagSearchBarBackgroundColor"
            android:elevation="0dp"
            android:outlineProvider="none"
            app:icon="@drawable/plus_sign"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="?attr/textOnGenericSurfaceColor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialog_select_tag_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/recyclerViewBackgroundColor"
        android:clipToPadding="false"
        android:layout_below="@id/dialog_select_tag_bar">

    </androidx.recyclerview.widget.RecyclerView>

    <LinearLayout
        android:id="@+id/dialog_select_tag_no_results_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dialog_select_tag_recyclerview"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/dialog_select_tag_no_results_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textOnRecyclerViewBackgroundColor"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:textSize="18sp"
            android:text="No tags found"/>

        <TextView
            android:id="@+id/dialog_select_tag_no_results_textview_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textOnRecyclerViewBackgroundColor"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"
            android:text="Try refining your search or create a new tag"
            />

        <Button
            android:id="@+id/dialog_select_tag_no_results_add_tag_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="?attr/textOnAccentColor"
            android:backgroundTint="?attr/colorAccent"
            android:text="+ Add new tag" />

    </LinearLayout>

</RelativeLayout>